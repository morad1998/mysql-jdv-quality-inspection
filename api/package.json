{
  "name": "mysql-jdv-quality-inspection-api",
  "private": true,
  "type": "module",
  "description": "Demo API for the MySQL JSON Duality Views quality-inspection example (demo authentication only)",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file=../.env src/server.ts",
    "test": "node --test test/unit.test.ts test/routes.test.ts",
    "test:integration": "node --env-file=../.env --test test/integration.test.ts",
    "typecheck": "tsc --noEmit",
    "cleanup": "node --env-file=../.env scripts/cleanup-cards.ts",
    "examples": "node --env-file=../.env examples/run-examples.ts"
  },
  "dependencies": {
    "mysql2": "^3.24.6"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  }
}
